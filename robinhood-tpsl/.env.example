# 复制成 .env 再改。.env 不会提交到仓库。

# 后端：demo（默认，模拟数据） | official（Robinhood Agentic Trading） | unofficial（robin_stocks）
TPSL_BACKEND=demo

# 真实后端默认只演练、不发单。确认预览都对了以后改成 1 才会真的下单。
TPSL_LIVE=0

# 监听地址。保持 127.0.0.1，手机用 tailscale serve 连进来（见 README）。
TPSL_HOST=127.0.0.1
TPSL_PORT=8787

# 盯盘多久看一次价格（秒）；止盈限价单挂出后多久没成交且价格回落就撤掉、挂回止损（秒）
TPSL_WATCH_INTERVAL=20
TPSL_TP_TIMEOUT=120
